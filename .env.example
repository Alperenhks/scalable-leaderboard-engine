# PostgreSQL — kimlik, cüzdan ve ödül kayıtları (transactional kaynak)
# Örnek biçim: postgresql://<user>:<password>@localhost:5432/<db>?schema=public
DATABASE_URL=

# Redis — canlı liderlik tablosu (Sorted Set)
# Örnek biçim: redis://localhost:6379
REDIS_URL=

# MongoDB — yüksek hacimli skor event log'ları
# Örnek biçim: mongodb://localhost:27017/<db>
MONGO_URI=

# JWT imzalama anahtarı
JWT_SECRET=

# HTTP sunucu portu
PORT=8080

# İzin verilen CORS origin'leri (virgülle ayrılmış, opsiyonel)
#
# Tanımlıysa YALNIZCA bu adresler kabul edilir. Boş bırakılırsa geliştirme
# varsayılanına düşülür: localhost portları + tüm *.vercel.app adresleri.
# Üretimde mutlaka daraltılmalıdır.
# Örnek: https://scalable-leaderboard-client.vercel.app
ALLOWED_ORIGINS=
