# PostgreSQL — kimlik, cüzdan ve ödül kayıtları (transactional kaynak)
# Örnek biçim: postgresql://<user>:<password>@localhost:5432/<db>?schema=public
DATABASE_URL=

# Redis — canlı liderlik tablosu (Sorted Set)
# Örnek biçim: redis://localhost:6379
REDIS_URL=

# MongoDB — yüksek hacimli skor event log'ları
# Örnek biçim: mongodb://localhost:27017/<db>
MONGO_URI=

# JWT imzalama anahtarı
JWT_SECRET=

# HTTP sunucu portu
PORT=8080

# Ödül dağıtımını elle tetiklemek için paylaşılan sır (opsiyonel, en az 16 karakter)
#
# Tanımlanmazsa admin token hiç üretilmez ve POST /api/rewards/distribute
# kimseye açık olmaz. Haftalık dağıtım cron ile zaten otomatik çalışır.
# Kullanım: POST /api/auth/identify  {"adminSecret": "<buradaki değer>"}
ADMIN_SECRET=
