// Panteon Scalable Leaderboard Engine — PostgreSQL şeması
//
// Sorumluluk sınırı: Postgres burada YALNIZCA transactional "source of truth"
// görevi görür (kimlik, para, ödül geçmişi). Canlı sıralama Redis Sorted Set'te,
// yüksek hacimli skor event'leri MongoDB'de tutulur. Leaderboard okuma yolu
// bu tablolara hiç dokunmaz — 2M DAU altında Postgres'i okuma trafiğinden
// izole etmek ölçeklenebilirliğin temel şartıdır.
//
// Bağlantı URL'i koda gömülmez; prisma.config.ts üzerinden process.env.DATABASE_URL okunur.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // NestJS CommonJS'e derleniyor. Varsayılan ESM çıktısı import.meta.url
  // kullanır; Node o dosyayı ESM sayar ama gövde CommonJS derlendiği için
  // "exports is not defined in ES module scope" ile çalışmaz.
  moduleFormat = "cjs"
  // Üretilen dosyalar .ts; varsayılan ".js" uzantılı import'ları Jest'in
  // çözümleyicisi eşleyemiyor (tsc eşliyor). Boş bırakmak her ikisini de
  // çalıştırır.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Oyuncu kimliği. Skor değeri burada TUTULMAZ — canlı skor Redis'in
/// otoritesindedir; buradaki alanlar kimlik ve sezon eşlemesi içindir.
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  country   String?  @db.Char(2) // ISO 3166-1 alpha-2, ülke bazlı liderlik için
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet     Wallet?
  rewardLogs RewardLog[]

  @@index([country])
  @@map("users")
}

/// Oyuncu bakiyesi. Kullanıcı başına tek cüzdan (1:1).
/// Para alanlarında Decimal kullanılır — Float para için kabul edilemez,
/// ikili kayan nokta yuvarlama hatası bakiyede sızıntı yaratır.
model Wallet {
  id      String  @id @default(cuid())
  userId  String  @unique
  balance Decimal @default(0) @db.Decimal(18, 4)
  /// Optimistic locking sayacı: eşzamanlı ödül yazımlarında lost update'i önler.
  version Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// Haftalık ödül dağıtım geçmişi (audit trail).
/// Bir oyuncuya aynı sezon için iki kez ödeme yapılmasını veritabanı
/// seviyesinde engellemek üzere (userId, seasonId) tekil kısıtı vardır —
/// idempotent dağıtım, dağıtım job'ının yeniden çalışmasına karşı korur.
model RewardLog {
  id       String @id @default(cuid())
  userId   String
  /// Sezon tanımlayıcısı, ör. "2026-W33" (ISO hafta).
  seasonId String
  /// Oyuncunun sezon sonundaki sıralaması.
  rank     Int
  /// Ödül anındaki skoru (denetim için dondurulmuş kopya).
  score    BigInt
  amount   Decimal      @db.Decimal(18, 4)
  status   RewardStatus @default(PENDING)
  /// Dağıtım başarısız olduysa nedeni.
  failureReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  distributedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, rank])
  @@index([status])
  @@map("reward_logs")
}

enum RewardStatus {
  PENDING
  DISTRIBUTED
  FAILED
}
